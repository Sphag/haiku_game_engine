{
  "format": "engine.animation_graph",
  "version": 1,
  "parameters": [
    {
      "name": "speed",
      "type": "float",
      "default": 0
    },
    {
      "name": "grounded",
      "type": "bool",
      "default": true
    },
    {
      "name": "jump",
      "type": "trigger"
    }
  ],
  "default_state": "idle",
  "root": {
    "joint": "root",
    "translate_x": true,
    "translate_y": false,
    "translate_z": true,
    "yaw": true
  },
  "states": [
    {
      "name": "idle",
      "clip": "idle",
      "speed": 1
    },
    {
      "name": "walk",
      "clip": "walk",
      "speed": 1
    },
    {
      "name": "jump",
      "clip": "jump",
      "speed": 1
    }
  ],
  "transitions": [
    {
      "from": "idle",
      "to": "walk",
      "duration": 0.25,
      "priority": 1,
      "conditions": [
        {
          "when": "float",
          "parameter": "speed",
          "op": ">",
          "value": 0.1
        }
      ]
    },
    {
      "from": "walk",
      "to": "idle",
      "duration": 0.25,
      "priority": 1,
      "conditions": [
        {
          "when": "float",
          "parameter": "speed",
          "op": "<=",
          "value": 0.1
        }
      ]
    },
    {
      "from": "idle",
      "to": "jump",
      "duration": 0.15,
      "priority": 5,
      "conditions": [
        {
          "when": "trigger",
          "parameter": "jump"
        }
      ]
    },
    {
      "from": "walk",
      "to": "jump",
      "duration": 0.15,
      "priority": 5,
      "conditions": [
        {
          "when": "trigger",
          "parameter": "jump"
        }
      ]
    },
    {
      "from": "jump",
      "to": "idle",
      "duration": 0.25,
      "priority": 1,
      "conditions": [
        {
          "when": "finished"
        }
      ]
    }
  ]
}
