{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "win-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-clang",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "win-dev",
      "displayName": "Windows, MSVC (run from a Visual Studio x64 developer environment)",
      "inherits": "win-base"
    },
    {
      "name": "linux-dev",
      "displayName": "Linux, Clang",
      "inherits": "linux-clang"
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux, GCC",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux, Clang with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-debug",
      "configurePreset": "win-dev",
      "configuration": "Debug"
    },
    {
      "name": "win-release",
      "configurePreset": "win-dev",
      "configuration": "Release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-dev",
      "configuration": "Debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-dev",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "win-unit",
      "configurePreset": "win-dev",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit|integration"
        }
      }
    },
    {
      "name": "win-release-unit",
      "configurePreset": "win-dev",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit|integration"
        }
      }
    },
    {
      "name": "linux-unit",
      "configurePreset": "linux-dev",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit|integration"
        }
      }
    },
    {
      "name": "linux-release-unit",
      "configurePreset": "linux-dev",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit|integration"
        }
      }
    },
    {
      "name": "linux-gcc-unit",
      "configurePreset": "linux-gcc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit|integration"
        }
      }
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-asan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit|integration"
        }
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    }
  ]
}
